# Copy this file to .env and fill in what you have.
# MindMesh runs fully offline with sensible defaults if you skip all of this.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True

# Assistant identity
ASSISTANT_NAME=MindMesh
WAKE_WORD=hey mindmesh

# Weather widget (https://openweathermap.org/api - free tier works)
# Leave blank to use simulated weather data.
OPENWEATHER_API_KEY=
DEFAULT_CITY=Aurangabad,IN

# Optional: let the agent's knowledge/chat answers be handled by a real
# LLM (via LangChain's ChatOpenAI) instead of the built-in offline
# responder — this is what lets it correctly answer questions Wikipedia
# alone can't (e.g. wrong-premise questions, opinions, comparisons).
# Supports any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, or a
# local server like Ollama/LM Studio).
#
# IMPORTANT: put your key HERE, in this .env file — never paste it
# directly into a .py file. .env is listed in .gitignore specifically so
# it's never committed or shared by accident; hardcoding a key in source
# means it ends up in git history, shared zips, and screenshots forever.
# If a key has ever been pasted somewhere public (a chat, a forum, a
# committed file), treat it as compromised and regenerate it from your
# provider's dashboard.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Using Google Gemini instead (OpenAI-compatible endpoint) ---
# Comment out the three lines above and use these instead:
# LLM_API_KEY=your-google-ai-studio-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3-flash-preview
# Optional: LLM_TEMPERATURE=1.0 (auto-set to 1.0 for Gemini 3 models if blank)
